# Velantin Live Stream — production environment template
# Add these values in Vercel Environment Variables. Never commit real secrets.

# Firebase Web configuration
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Firebase Admin SDK server credentials
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Agora live video and RTM
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# Application/admin
BETTER_AUTH_URL=https://YOUR-VERCEL-DOMAIN.vercel.app
ADMIN_EMAILS=admin@example.com

# PayPal
PAYMENTS_BUY_PROVIDER=paypal
PAYMENTS_WITHDRAW_PROVIDER=paypal
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=live
PAYPAL_CURRENCY=USD
PAYPAL_WEBHOOK_ID=

# OxaPay crypto coin purchases (set PAYMENTS_BUY_PROVIDER=oxapay)
OXAPAY_MERCHANT_API_KEY=
OXAPAY_CURRENCY=USD
OXAPAY_CALLBACK_URL=https://YOUR-VERCEL-DOMAIN.vercel.app/api/payments/webhook
OXAPAY_RETURN_URL=https://YOUR-VERCEL-DOMAIN.vercel.app/
OXAPAY_SANDBOX=false

# Creator economy (paid private rooms and subscriptions spend wallet coins)
DIAMONDS_PER_USD=200
CASHOUT_MIN_DIAMONDS=3000
PLATFORM_FEE_RATE=0.30

# Rewards and HilltopAds
DAILY_LOGIN_BONUS_COINS=10
AD_REWARD_COINS=5
AD_REWARD_COOLDOWN_MINUTES=2
AD_REWARD_DAILY_CAP=12
NEXT_PUBLIC_HILLTOP_VAST_URL=
