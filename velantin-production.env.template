# Valentine Express / Velantin Live Stream
# Copy this file to .env before local testing, or use each value in Vercel Environment Variables.
# NEVER commit the completed file to GitHub.

# =========================
# Core application
# =========================
DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST:5432/DATABASE_NAME
BETTER_AUTH_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
BETTER_AUTH_URL=https://YOUR-DOMAIN.com

# =========================
# Admin
# =========================
ADMIN_EMAILS=admin@example.com

# =========================
# Cloudinary - avatar, KYC, status images
# =========================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# =========================
# Payment provider selection
# =========================
PAYMENTS_BUY_PROVIDER=paypal
PAYMENTS_WITHDRAW_PROVIDER=paypal

# =========================
# PayPal
# =========================
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
