# Velantin Live Stream — Firebase/Vercel environment
# Copy to .env locally or add these values in Vercel. Never commit real secrets.

# Firebase Web configuration (safe to expose in the browser)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Firebase Admin SDK (server-only; never expose these as NEXT_PUBLIC_)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Agora live video and RTM
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
# Optional replay recording. Leave blank until Agora Cloud Recording and a
# durable Firebase Storage/S3-compatible destination are provisioned.
AGORA_CUSTOMER_ID=
AGORA_CUSTOMER_SECRET=
AGORA_RECORDING_BUCKET=
AGORA_RECORDING_REGION=

# Application/admin
BETTER_AUTH_URL=http://localhost:3000
ADMIN_EMAILS=admin@example.com

# PayPal coin purchases and creator payouts
PAYMENTS_BUY_PROVIDER=paypal
PAYMENTS_WITHDRAW_PROVIDER=paypal
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_CURRENCY=USD
PAYPAL_WEBHOOK_ID=

# OxaPay crypto coin purchases (set PAYMENTS_BUY_PROVIDER=oxapay)
OXAPAY_MERCHANT_API_KEY=
OXAPAY_CURRENCY=USD
OXAPAY_CALLBACK_URL=http://localhost:3000/api/payments/webhook
OXAPAY_RETURN_URL=http://localhost:3000/
OXAPAY_SANDBOX=true

# Creator economy (paid private rooms and subscriptions spend wallet coins)
DIAMONDS_PER_USD=200
CASHOUT_MIN_DIAMONDS=3000
PLATFORM_FEE_RATE=0.30
REFERRAL_REWARD_COINS=56

# Daily bonus and rewarded ads
DAILY_LOGIN_BONUS_COINS=10
AD_REWARD_COINS=5
AD_REWARD_COOLDOWN_MINUTES=2
AD_REWARD_DAILY_CAP=12
NEXT_PUBLIC_HILLTOP_VAST_URL=

# Optional WebRTC TURN server
TURN_URL=
TURN_USER=
TURN_PASS=
NEXT_PUBLIC_TURN_URL=
NEXT_PUBLIC_TURN_USER=
NEXT_PUBLIC_TURN_PASS=
